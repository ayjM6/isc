# Recipes for building, testing and releasing isc. Run `just` to list them.
# Any logic beyond a single tool call lives here, not in workflow YAML.

set shell := ["bash", "-euo", "pipefail", "-c"]
set positional-arguments

# oc-mirror commit the copy in internal/ocmirror/ is synced from.
ocmirror_pin := `cat internal/ocmirror/PIN`

# List the recipes
default:
    @just --list

# Build the binary into dist/, with the version from git
build:
    go build -trimpath -ldflags "-X main.version=$(git describe --tags --always --dirty 2>/dev/null || echo dev)" -o dist/isc ./cmd/isc

# gofmt check, go vet and go test
test:
    test -z "$(gofmt -l . | tee /dev/stderr)"
    go vet ./...
    go test ./...

# Build, then run isc with the arguments, from the caller's directory
[no-cd]
run *args:
    just --justfile "{{justfile()}}" build
    "{{justfile_directory()}}/dist/isc" "$@"

# Refresh the pinned copy of oc-mirror code in internal/ocmirror/ from REF (default: PIN)
sync-ocmirror ref=ocmirror_pin:
    #!/usr/bin/env bash
    set -euo pipefail
    # oc-mirror can't be fetched as a Go module (some testdata file names contain ':'),
    # so fetch only the files we copy, at the pinned commit, with a sparse shallow clone.
    src=$(mktemp -d)
    trap 'rm -rf "$src"' EXIT
    git -C "$src" init -q
    git -C "$src" remote add origin https://github.com/openshift/oc-mirror
    git -C "$src" sparse-checkout set --no-cone \
        /LICENSE \
        /internal/pkg/config/load.go /internal/pkg/config/load_test.go \
        /internal/pkg/config/validate.go /internal/pkg/config/validate_test.go \
        /internal/pkg/config/defaults.go /internal/pkg/config/defaults_test.go \
        /internal/pkg/config/metadata.go \
        '/internal/pkg/api/v2alpha1/*.go' '/internal/pkg/image/*.go' '/internal/pkg/consts/*.go' \
        /tests/unit/testdata/config/valid.yaml /tests/unit/testdata/config/valid-delete.yaml \
        /tests/unit/testdata/isc.yaml /tests/unit/testdata/delete-isc.yaml
    git -C "$src" fetch -q --depth 1 --filter=blob:none origin "{{ref}}"
    git -C "$src" checkout -q FETCH_HEAD
    commit=$(git -C "$src" rev-parse HEAD)

    dst=internal/ocmirror
    rm -rf "$dst/config" "$dst/api" "$dst/image" "$dst/consts" tests/unit/testdata
    mkdir -p "$dst/config" "$dst/api/v2alpha1" "$dst/image" "$dst/consts" tests/unit/testdata/config
    cp "$src"/internal/pkg/config/*.go "$dst/config/"
    cp "$src"/internal/pkg/api/v2alpha1/*.go "$dst/api/v2alpha1/"
    cp "$src"/internal/pkg/image/*.go "$dst/image/"
    cp "$src"/internal/pkg/consts/*.go "$dst/consts/"
    cp "$src"/tests/unit/testdata/config/*.yaml tests/unit/testdata/config/
    cp "$src"/tests/unit/testdata/isc.yaml "$src"/tests/unit/testdata/delete-isc.yaml tests/unit/testdata/
    cp "$src/LICENSE" "$dst/LICENSE"

    # The only change to the copied code: import paths.
    find "$dst" -name '*.go' -exec sed -i \
        's#github.com/openshift/oc-mirror/v2/internal/pkg/#github.com/ayjM6/isc/internal/ocmirror/#g' {} +
    printf '%s\n' "$commit" > "$dst/PIN"
    printf '// Code generated by just sync-ocmirror. DO NOT EDIT.\n\npackage ocmirror\n\n// Commit is the oc-mirror commit the code in this directory was copied from.\nconst Commit = "%s"\n' "$commit" > "$dst/pin.go"
    gofmt -w "$dst"
    echo "synced internal/ocmirror from oc-mirror $commit"

# Fail if internal/ocmirror/ differs from a fresh sync at PIN
check-sync: sync-ocmirror
    git diff --exit-code -- internal/ocmirror tests/unit/testdata
    test -z "$(git status --porcelain -- internal/ocmirror tests/unit/testdata)"

# goreleaser for local snapshots, run with `go run` at a pinned version so nothing
# needs installing (the newest release that builds with the Go version in go.mod).
# CI uses the goreleaser GitHub Action at the same version. git-cliff (versions and
# release notes) is a Rust tool: install it locally, CI installs it itself.
goreleaser := "go run github.com/goreleaser/goreleaser/v2@v2.15.0"

# Conventional Commit subject: type(scope)!: description
conventional_re := '^(feat|fix|docs|refactor|perf|test|build|ci|chore|style|revert)(\([a-z0-9._/-]+\))?!?: .+'

# Check every commit in BASE..HEAD (merges aside) follows Conventional Commits
check-commits base:
    #!/usr/bin/env bash
    set -euo pipefail
    re='{{conventional_re}}'
    bad=0
    while IFS= read -r line; do
        subject=${line#* }
        if [[ ! "$subject" =~ $re ]]; then
            echo "error: commit ${line%% *} isn't a Conventional Commit: $subject" >&2
            bad=1
        fi
    done < <(git log --no-merges --format='%h %s' "$1..HEAD")
    exit "$bad"

# Check a pull request title follows Conventional Commits
check-title title:
    #!/usr/bin/env bash
    set -euo pipefail
    re='{{conventional_re}}'
    if [[ ! "$1" =~ $re ]]; then
        echo "error: title isn't a Conventional Commit subject (e.g. 'feat: add isc validate'): $1" >&2
        exit 1
    fi

# Print the version a release would get: BUMP is auto|patch|minor|major, PRERELEASE e.g. rc
next-version bump="auto" prerelease="":
    #!/usr/bin/env bash
    set -euo pipefail
    # git-cliff bumps from the commits since the last release tag (cliff.toml [bump]).
    case "$1" in
        auto) version=$(git cliff --bumped-version) ;;
        patch|minor|major) version=$(git cliff --bump "$1" --bumped-version) ;;
        *) echo "error: bump must be auto, patch, minor or major: $1" >&2; exit 2 ;;
    esac
    if git rev-parse -q --verify "refs/tags/$version" > /dev/null; then
        echo "error: $version already exists: nothing to release since it" >&2
        exit 1
    fi
    if [[ -n "$2" ]]; then
        n=1
        while git rev-parse -q --verify "refs/tags/$version-$2.$n" > /dev/null; do n=$((n + 1)); done
        version="$version-$2.$n"
    fi
    echo "$version"

# Print the unreleased release notes
changelog:
    git cliff --unreleased --strip all

# Create the annotated release tag VERSION at HEAD (no push)
tag-release version:
    git tag -a "$1" -m "$1"

# Print the release notes for TAG (its section, from the commits since the previous release tag)
release-notes tag:
    #!/usr/bin/env bash
    set -euo pipefail
    if [[ "$(git rev-parse HEAD)" != "$(git rev-parse "$1^{commit}")" ]]; then
        echo "error: HEAD isn't at $1" >&2
        exit 1
    fi
    git cliff --current --strip all

# Check TAG is a strict semantic version tag on main
check-tag tag:
    #!/usr/bin/env bash
    set -euo pipefail
    re='^v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$'
    if [[ ! "$1" =~ $re ]]; then
        echo "error: $1 isn't a semantic version tag (vMAJOR.MINOR.PATCH[-PRERELEASE])" >&2
        exit 1
    fi
    main=$(git rev-parse -q --verify origin/main || git rev-parse --verify main)
    if ! git merge-base --is-ancestor "$1^{commit}" "$main"; then
        echo "error: $1 doesn't point at a commit on main" >&2
        exit 1
    fi

# Check the goreleaser config and build every target locally, without publishing
release-snapshot:
    {{goreleaser}} check
    {{goreleaser}} release --snapshot --clean
